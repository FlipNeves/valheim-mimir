# Copie para .env e ajuste conforme necessário.
# Nada aqui é secreto por enquanto (setup local), mas a estrutura já
# suporta o cenário "público depois" (host remoto, chave de API, etc.).

# --- Ollama ---
OLLAMA_HOST=http://localhost:11434
# qwen2.5:3b-instruct é leve (~2GB, cabe na GPU de 6GB sem carga na CPU).
# Para máxima qualidade (máquina mais forte), use qwen2.5:7b-instruct.
LLM_MODEL=qwen2.5:3b-instruct
# bge-m3 é multilíngue: casa perguntas em PT com o corpus em inglês sem tradução.
EMBED_MODEL=bge-m3
# Prefixos de tarefa (usados pela família nomic-embed). bge-m3 NÃO precisa —
# deixe vazio. Só preencha se trocar para nomic-embed-text.
EMBED_QUERY_PREFIX=
EMBED_DOC_PREFIX=
# Mantém modelos carregados na memória (evita recarregar a cada pergunta).
OLLAMA_KEEP_ALIVE=30m
# Camadas do embedding na GPU. Em GPU de ~6GB, o LLM enche a VRAM; rodar o
# embed na CPU (0) evita o swap qwen<->bge e deixa ambos residentes.
# Para o reindex em massa (LLM ocioso), rode com EMBED_NUM_GPU=-1 (usa GPU).
EMBED_NUM_GPU=0
# Camadas do LLM na GPU. -1 = automático (usa a GPU). 0 = LLM todo na CPU:
# libera a GPU 100% para o Valheim (mais lento, mas sem travar o jogo).
LLM_NUM_GPU=-1

# --- Provider de geração (LLM) ---
# auto  = usa o Ollama local; se ele não existir, cai para o Gemini.
# ollama = força o Ollama. gemini = força o Gemini.
# Obs.: só a GERAÇÃO tem fallback — os embeddings/busca seguem no Ollama.
LLM_PROVIDER=auto
# Chave da API do Gemini (Google AI Studio). Necessária p/ o fallback.
GEMINI_API_KEY=
# gemini-flash-latest aponta sempre pro flash atual. Se der 429 (quota), o free
# tier do seu projeto pode estar zerado — habilite billing na API (barato).
GEMINI_MODEL=gemini-flash-latest

# --- Scraping ---
# Delay aleatório (segundos) entre requisições à wiki. Menor = mais rápido,
# maior = mais educado com o servidor.
SCRAPE_MIN_DELAY=1.0
SCRAPE_MAX_DELAY=2.0

# --- ChromaDB ---
CHROMA_COLLECTION=wiki_rag
# hnsw:space — cosine é o correto para embeddings de texto.
CHROMA_SPACE=cosine

# --- RAG ---
RAG_TOP_K=5
# Similaridade mínima (0..1) para um chunk entrar no contexto. 0 = sem filtro.
RAG_MIN_SIMILARITY=0.3
# Reescreve a pergunta PT como query curta em inglês antes da busca (melhora a
# precisão em nomes de itens). Custa +1 chamada ao LLM (~2-4s). true/false.
RAG_QUERY_REWRITE=true

# --- API ---
API_HOST=0.0.0.0
API_PORT=8000
# CORS: origens permitidas separadas por vírgula (* = todas — só para dev).
API_CORS_ORIGINS=*
# Auth por chave. Vazio = sem exigência (local). Ao expor à internet, DEFINA
# uma chave — os amigos a colocam no config do mod (header X-API-Key).
API_KEY=
# Limite de requisições por minuto (por chave/IP). 0 = sem limite.
# Protege a quota do Gemini contra abuso quando a URL for pública.
RATE_LIMIT_PER_MINUTE=20

# --- Exposição pública (Cloudflare Tunnel + publicação da URL no GitHub) ---
# Clone local do repo dedicado onde a URL da sessão é publicada (commit+push).
ENDPOINT_REPO_DIR=
ENDPOINT_FILE=endpoint.txt
# Opcional: caminho do cloudflared se não estiver no PATH.
CLOUDFLARED_PATH=
